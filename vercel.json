{
  "version": 2,
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "api/scan.py", "use": "@vercel/python" },
    { "src": "api/screener.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/scan", "dest": "api/scan.py" },
    { "src": "/api/v2/screener", "dest": "api/screener.py" },
    { "src": "/api/screener", "dest": "api/screener.py" },
    { "src": "/api/all-tickers", "dest": "api/screener.py" },
    { "src": "/api/(.*)", "dest": "api/index.py" }
  ]
}
