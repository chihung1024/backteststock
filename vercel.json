{
  "version": 2,
  "builds": [
    { "src": "api/index_v2.py", "use": "@vercel/python" },
    { "src": "api/scan_v2.py", "use": "@vercel/python" },
    { "src": "api/screener.py", "use": "@vercel/python" },
    { "src": "api/exhaustive_optimizer.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/scan", "dest": "api/scan_v2.py" },
    { "src": "/api/optimizer/exhaustive/(.*)", "dest": "api/exhaustive_optimizer.py" },
    { "src": "/api/v2/screener", "dest": "api/screener.py" },
    { "src": "/api/screener", "dest": "api/screener.py" },
    { "src": "/api/all-tickers", "dest": "api/screener.py" },
    { "src": "/api/(.*)", "dest": "api/index_v2.py" }
  ]
}
