{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backteststock",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/scheduled_entry.js",
  "vars": {
    "BACKEND_ORIGIN": "https://stockbacktest.vercel.app"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "backteststock-universe"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
